        </symbol>
        <symbol id="monitor-transports" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="7" rx="2"/>
            <rect x="3" y="13" width="18" height="7" rx="2"/>
            <path d="M7 7.5h.01M7 16.5h.01M11 7.5h6m-6 9h6"/>
        </symbol>
        <symbol id="monitor-history" viewBox="0 0 24 24">
            <path d="M3 12a9 9 0 1 0 2.64-6.36L3 8m0-5v5h5m4-1v5l3 2"/>
        </symbol>
        <symbol id="monitor-statistics" viewBox="0 0 24 24">
