        </symbol>
        <symbol id="monitor-timer" viewBox="0 0 24 24">
            <circle cx="12" cy="13" r="8"/>
            <path d="M10 2h4m-2 7v4l2 2"/>
        </symbol>
        <symbol id="monitor-bolt" viewBox="0 0 24 24">
            <path d="M13 2 4 14h7l-1 8 10-12h-7z"/>
        </symbol>
