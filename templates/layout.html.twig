<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block meta_title %}Messenger Monitor: {% block title %}{% endblock %}{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,{{ include('@ZenstruckMessengerMonitor/icon.svg.twig')|url_encode }}">

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">

        <style>
            {{ include('@ZenstruckMessengerMonitor/styles.css.twig') }}
        </style>
    {% endblock %}

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.min.js" integrity="sha384-Rx+T1VzGupg4BHQYs2gCW9It+akI2MM/mndMCy36UVfodzcJcF0GGLxZIzObiEfa" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/htmx.org@1.9.12/dist/htmx.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/idiomorph@0.3.0/dist/idiomorph-ext.min.js"></script>

        <script type="module">
            import { Application, Controller } from "https://cdn.jsdelivr.net/npm/@hotwired/stimulus/+esm"
            window.Stimulus = Application.start()

            Stimulus.register('refreshable', class extends Controller {
                static values = {
                    url: String,
                    poll: {
                        type: Number,
                        default: 5000,
                    },
                    autorefresh: {
                        type: Boolean,
                        default: true,
                    }
                };
                static targets = ['indicator', 'content', 'start', 'pause', 'refresh'];

                interval;

                connect() {
                    if (this.autorefreshValue) {
                        this.start();
                    }
                }

                start() {
                    this.interval = setInterval(() => this.refresh(), this.pollValue);

                    if (this.hasStartTarget) {
                        this.startTarget.classList.add('d-none');
                    }

                    if (this.hasPauseTarget) {
                        this.pauseTarget.classList.remove('d-none');
                    }

                    if (this.hasRefreshTarget) {
                        this.refreshTarget.classList.add('d-none');
                    }

                    if (this.hasIndicatorTarget) {
                        this.indicatorTarget.classList.remove('d-none');
                    }
                }

                pause() {
                    clearInterval(this.interval);

                    if (this.hasStartTarget) {
                        this.startTarget.classList.remove('d-none');
                    }

                    if (this.hasPauseTarget) {
                        this.pauseTarget.classList.add('d-none');
                    }

                    if (this.hasRefreshTarget) {
                        this.refreshTarget.classList.remove('d-none');
                    }

                    if (this.hasIndicatorTarget) {
                        this.indicatorTarget.classList.add('d-none');
                    }
                }

                async refresh() {
                    if (document.hidden) {
                        return;
                    }

                    try {
                        const response = await fetch(this.urlValue);
                        const html = await response.text();

                        Idiomorph.morph(this.contentTarget, html, { morphStyle: 'innerHTML'});
                    } catch (error) {
                        console.error('Error:', error);
                    }
                }
            });

            Stimulus.register('message-details', class extends Controller {
                click(event) {
                    event.preventDefault();

                    fetch(this.element.getAttribute('href'))
                        .then(response => response.text())
                        .then(html => {
                            const modal = new bootstrap.Modal(document.getElementById('message-details-modal'));
                            const modalContent = modal._element.querySelector('.modal-content');

                            modalContent.innerHTML = html;
                            modal.show();
                        })
                        .catch(error => console.error('Error:', error))
                    ;
                }
            });

            Stimulus.register('toast', class extends Controller {
                connect() {
                    (new bootstrap.Toast(this.element)).show();
                }
            });

            Stimulus.register('post-link', class extends Controller {
                click(event) {
                    event.preventDefault();

                    if (this.element.dataset.confirm && !confirm(this.element.dataset.confirm)) {
                        return;
                    }

                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = this.element.getAttribute('href');

                    if (this.element.dataset.token) {
                        form.appendChild(this.csrfToken(this.element.dataset.token));
                    }

                    document.body.appendChild(form);
                    form.requestSubmit();
                }

                csrfToken(value) {
                    const token = document.createElement('input');
                    token.type = 'hidden';
                    token.name = '_token';
                    token.value = value;
                    token.dataset.controller = 'csrf-protection';

                    // Symfony's stateless marker becomes a matching form token and cookie.
                    if (/^[-_a-zA-Z0-9]+$/.test(value)) {
                        token.dataset.csrfProtectionCookieValue = value;
                        token.value = btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(18))));
                        const cookie = `${value}_${token.value}=${value}; path=/; samesite=strict`;
                        document.cookie = location.protocol === 'https:' ? `__Host-${cookie}; secure` : cookie;
                    }

                    return token;
                }
            });

            Stimulus.register('clipboard', class extends Controller {
                static targets = ['source', 'button'];

                async copy() {
                    try {
                        await navigator.clipboard.writeText(this.sourceTarget.textContent);
                        this.showFeedback(true);
                    } catch (err) {
                        this.showFeedback(false);
                    }
                }

                showFeedback(success) {
                    const button = this.buttonTarget;
                    const icon = button.querySelector('use');

                    clearTimeout(this.feedbackTimeout);

                    icon.setAttribute('xlink:href', success ? '#check-circle-fill' : '#exclamation-triangle-fill');
                    button.classList.toggle('text-success', success);
                    button.classList.toggle('text-danger', !success);

                    this.feedbackTimeout = setTimeout(() => {
                        icon.setAttribute('xlink:href', '#clipboard-icon');
                        button.classList.remove('text-success', 'text-danger');
                    }, 1500);
                }
            });
        </script>
    {% endblock %}
</head>
<body>
<a class="visually-hidden-focusable monitor-skip-link" href="#monitor-content">Skip to content</a>
<div class="monitor-shell">
    {% block navbar %}
        <nav class="navbar navbar-expand-lg monitor-sidebar" aria-label="Main navigation">
            <a href="{{ path('zenstruck_messenger_monitor_dashboard') }}" class="navbar-brand monitor-brand">
                <span class="monitor-brand-mark">
                    {{ include('@ZenstruckMessengerMonitor/icon.svg.twig', {size: 23}) }}
                </span>
                <span>Messenger <small>MONITOR</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                {% block navbar_menu %}
                    {% from _self import nav_link %}
                    {% set route = app.current_route %}
                    {% set countable_transports = helper.transports.filter.countable %}
                    <div class="monitor-nav-label">Workspace</div>
                    <ul class="navbar-nav">
                        {{ nav_link('dashboard', route, 'monitor-dashboard', 'Dashboard') }}

                        {% if countable_transports|length %}
                            {% set active = route == 'zenstruck_messenger_monitor_transport' %}
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle{{ active ? ' active' }}" type="button" data-bs-toggle="dropdown" aria-expanded="false"{% if active %} aria-current="page"{% endif %}>
                                    <svg width="18" height="18" aria-hidden="true"><use href="#monitor-transports"/></svg>
                                    Transports
                                </button>
                                <ul class="dropdown-menu">
                                    {% for item in countable_transports %}
                                        {% set queue_count = item|length %}
                                        <li>
                                            <a class="dropdown-item d-flex justify-content-between align-items-center gap-3" href="{{ path('zenstruck_messenger_monitor_transport', {name: item.name}) }}">
                                                {{ item.name }}
                                                <span class="badge text-bg-{{ queue_count > 0 ? (item.isFailure ? 'danger' : 'primary') : 'secondary' }}">{{ queue_count }}</span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% endif %}

                        {{ nav_link('history', route, 'monitor-history', 'History') }}
                        {{ nav_link('statistics', route, 'monitor-statistics', 'Statistics') }}

                        {% if helper.schedules and helper.schedules|length %}
                            {% set schedule_health = 'success' %}
                            {% for item in helper.schedules %}
                                {% if not item.isRunning %}
                                    {% set schedule_health = 'danger' %}
                                {% endif %}
                            {% endfor %}

                            {{ nav_link('schedule', route, 'monitor-schedule', helper.schedules|length > 1 ? 'Schedules' : 'Schedule', schedule_health) }}
                        {% endif %}
                    </ul>
                {% endblock %}

                <div class="monitor-environment">
                    <span>Environment</span>
                    <span class="environment-info">{{ app.environment }}</span>
                </div>

                {% set custom_menu %}
                    {% block navbar_custom_menu %}{% endblock %}
                {% endset %}

                {% if custom_menu|trim is not empty %}
                    <div class="monitor-custom-menu">
                        <div class="monitor-nav-label" id="monitor-custom-menu-label">Application</div>
                        <ul class="navbar-nav" aria-labelledby="monitor-custom-menu-label">
                            {{ custom_menu }}
                        </ul>
                    </div>
                {% endif %}
            </div>
        </nav>
    {% endblock %}

    <div class="monitor-workspace">
        {% block body %}
            <main class="monitor-content" id="monitor-content" tabindex="-1">
                {% block breadcrumbs %}
                    <nav aria-label="Breadcrumb">
                        <ol class="breadcrumb">
                            {% block breadcrumb_items %}
                                <li class="breadcrumb-item"><a href="{{ path('zenstruck_messenger_monitor_dashboard') }}">Dashboard</a></li>
                            {% endblock %}
                        </ol>
                    </nav>
                {% endblock %}
                {% block page_header %}
                    <header class="monitor-page-header">
                        <h1>{{ block('title') }}</h1>
                        {% block page_intro %}{% endblock %}
                    </header>
                {% endblock %}
                {% block content %}{% endblock %}
            </main>
        {% endblock %}
        {% block footer %}
            <footer class="monitor-footer">
                <span>Zenstruck Messenger Monitor</span>
                <a href="https://github.com/sponsors/kbond" target="_blank" rel="noopener">Sponsor Kevin Bond <span aria-hidden="true">↗</span></a>
            </footer>
        {% endblock %}
    </div>
</div>

{% macro nav_link(page, current_route, icon, label, health = null) %}
    {% set route = 'zenstruck_messenger_monitor_' ~ page %}
    <li class="nav-item">
        <a class="nav-link{{ route == current_route ? ' active' }}"{% if route == current_route %} aria-current="page"{% endif %} href="{{ path(route) }}">
            <svg width="18" height="18" aria-hidden="true"><use href="#{{ icon }}"/></svg>
            {{ label }}
            {% if health %}
                <span class="monitor-nav-status bg-{{ health }}">
                    <span class="visually-hidden">{{ health == 'success' ? 'All schedules running' : 'Schedule worker missing' }}</span>
                </span>
            {% endif %}
        </a>
    </li>
{% endmacro %}

