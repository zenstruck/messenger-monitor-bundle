<div data-controller="refreshable" class="monitor-widget" data-refreshable-url-value="{{ url }}">
    <div class="monitor-widget-controls">
        <span class="monitor-live d-none" data-refreshable-target="indicator">Live</span>
        {% block buttons %}
            <button type="button" title="Refresh" aria-label="Refresh" data-action="refreshable#refresh" data-refreshable-target="refresh" class="d-none btn btn-light btn-sm monitor-icon-button">
                <svg width="16" height="16" fill="currentColor" aria-hidden="true"><use href="#refresh-icon"/></svg>
            </button>
            <button type="button" title="Pause automatic refresh" aria-label="Pause automatic refresh" data-action="refreshable#pause" data-refreshable-target="pause" class="d-none btn btn-light btn-sm monitor-icon-button">
                <svg width="16" height="16" fill="currentColor" aria-hidden="true"><use href="#pause-icon"/></svg>
            </button>
            <button type="button" title="Resume automatic refresh" aria-label="Resume automatic refresh" data-action="refreshable#start" data-refreshable-target="start" class="d-none btn btn-light btn-sm monitor-icon-button">
                <svg width="16" height="16" fill="currentColor" aria-hidden="true"><use href="#play-icon"/></svg>
            </button>
        {% endblock %}
    </div>
    <div data-refreshable-target="content">
        {% block content %}{% endblock %}
    </div>
</div>
