{% set fail_rate = (snapshot.failRate * 100)|round(2) %}
{% set wait_time = snapshot.averageWaitTime %}
{% set handling_time = snapshot.averageHandlingTime %}
{% set metrics = [
    {label: 'Processed', value: snapshot.totalCount|number_format, icon: 'monitor-transports', tone: 'primary'},
    {label: 'Failure rate', value: fail_rate ~ '%', icon: 'monitor-activity', tone: fail_rate >= 10 ? 'danger' : (fail_rate >= 5 ? 'warning' : 'success')},
    {label: 'Avg. wait time', value: helper.formatDuration(wait_time), title: (wait_time / 1000)|round(3) ~ 's', icon: 'monitor-timer', tone: 'primary'},
    {label: 'Avg. handling time', value: helper.formatDuration(handling_time), title: (handling_time / 1000)|round(3) ~ 's', icon: 'monitor-bolt', tone: 'primary'},
] %}

<section class="card monitor-snapshot">
    <div class="card-header">
        <h2 class="monitor-section-title">Processing snapshot</h2>
        {% if subtitle is defined %}
            <span class="monitor-meta">{{ subtitle }}</span>
        {% endif %}
    </div>
    <dl class="monitor-metrics">
        {% for metric in metrics %}
            <div class="monitor-metric">
                <dt>
                    <span class="monitor-metric-icon text-{{ metric.tone }}-emphasis bg-{{ metric.tone }}-subtle">
                        <svg width="17" height="17" aria-hidden="true"><use href="#{{ metric.icon }}"/></svg>
                    </span>
                    {{ metric.label }}
                </dt>
                <dd class="monitor-metric-value{% if metric.icon == 'monitor-activity' %} text-{{ metric.tone }}-emphasis{% endif %}">
                    {% if metric.title is defined %}
                        <abbr title="{{ metric.title }}">{{ metric.value }}</abbr>
                    {% else %}
                        {{ metric.value }}
                    {% endif %}
                </dd>
            </div>
        {% endfor %}
    </dl>
    <div class="monitor-throughput">
        <span><strong>{{ snapshot.failureCount|number_format }}</strong> failed</span>
        <span><strong>{{ snapshot.handledPerMinute|round(2) }}</strong> / min</span>
        <span><strong>{{ snapshot.handledPerHour|round(2) }}</strong> / hr</span>
        <span><strong>{{ snapshot.handledPerDay|round(2) }}</strong> / day</span>
    </div>
</section>
