{% extends '@ZenstruckMessengerMonitor/layout.html.twig' %}

{% block title %}Transports{% endblock %}

{% block breadcrumb_items %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">Transports</li>
{% endblock %}

{% block page_intro %}<p>Inspect queued and failed messages across your transports.</p>{% endblock %}

{% block content %}
    {% set selected_queue_count = transport|length %}
    <div class="card mb-3">
        <div class="card-header monitor-tab-header">
            <ul class="nav nav-pills monitor-tabs" aria-label="Transports">
                {% for item in transports %}
                    {% set active = item.name == transport.name %}
                    {% set queue_count = active ? selected_queue_count : item|length %}
                    <li class="nav-item">
                        <a href="{{ path('zenstruck_messenger_monitor_transport', {name: item.name}) }}" class="nav-link{{ active ? ' active' }}"{% if active %} aria-current="page"{% endif %}>
                            {{ item.name }}
                            <span class="badge text-bg-{{ queue_count ? (item.isFailure ? 'danger' : 'primary') : 'secondary' }}">
                                {{ queue_count }} <span class="visually-hidden">queued messages</span>
                            </span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
            {{ include('@ZenstruckMessengerMonitor/_refresh_button.html.twig') }}
        </div>
        <div class="tab-content">
            {% if not selected_queue_count %}
                <div class="card-alert card-text alert alert-light d-flex align-items-center" role="alert">
                    <svg fill="currentcolor" height="1em" width="1em" class="me-1 align-text-bottom" role="img" aria-label="Info:"><use xlink:href="#info-fill"/></svg>
                    <div>
                        No messages in this queue.
                    </div>
                </div>
            {% elseif not transport.isListable %}
                <div class="card-alert card-text alert alert-light d-flex align-items-center" role="alert">
                    <svg fill="currentcolor" height="1em" width="1em" class="me-1 align-text-bottom" role="img" aria-label="Info:"><use xlink:href="#info-fill"/></svg>
                    <div>
                        This transport is not listable.
                    </div>
                </div>
            {% else %}
                {% set queuedMessages = transport.list(limit) %}

                {% if queuedMessages|length == limit %}
                    <div class="card-alert card-text alert alert-warning d-flex align-items-center" role="alert">
                        <svg fill="currentcolor" height="1em" width="1em" class="me-1 align-text-bottom" role="img" aria-label="Info:"><use xlink:href="#info-fill"/></svg>
                        <div>
                            Only showing the oldest {{ limit }} messages.
                        </div>
                    </div>
                {% endif %}

                <div class="table-responsive">
                    <table class="table card-table table-striped text-nowrap align-middle">
                        <thead>
                        <tr>
                            <th>Message</th>
                            <th>Dispatched At</th>
                            <th>Tags</th>
                            {% if transport.isFailure %}
                                <th>Exception</th>
                            {% endif %}
                            <th>&nbsp;</th>
                        </tr>
                        </thead>
                        <tbody>
                            {% for queued in queuedMessages %}
                                <tr>
                                    <td>
                                        <abbr title="{{ queued.message }}">{{ queued.message.shortName }}</abbr>
                                        {% if queued.message.description %}
                                            <br><small class="text-secondary">{{ queued.message.description }}</small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if queued.dispatchedAt %}
                                            <abbr title="{{ queued.dispatchedAt|date('c') }}">{{ helper.formatTime(queued.dispatchedAt) }}</abbr>
                                        {% else %}
                                            <em class="text-secondary">n/a</em>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% for tag in queued.tags %}
                                            <span class="badge align-text-top text-bg-secondary">{{ tag }}</span>
                                        {% endfor %}
                                    </td>
                                    {% if transport.isFailure %}
                                        <td>
                                            {% if queued.exception %}
                                                <strong class="text-danger"><abbr title="{{ queued.exception }}">{{ queued.exception.shortName }}</abbr></strong>
                                                <br><small class="text-secondary">{{ queued.exception.description }}</small>
                                                {% set trace = queued.exceptionTrace %}
                                                {% if trace %}
                                                    <details class="mt-1">
                                                        <summary>Stack trace</summary>
                                                        <pre class="mb-0 mt-2" style="white-space: pre; max-height: 340px; overflow: auto;">{{ trace }}</pre>
                                                    </details>
                                                {% endif %}
                                            {% else %}
                                                <em class="text-secondary">n/a</em>
                                            {% endif %}
                                        </td>
                                    {% endif %}
                                    <td class="text-end">
                                        <a href="{{ path('zenstruck_messenger_monitor_transport_remove', {name: transport.name, id: queued.id}) }}" data-controller="post-link" data-action="post-link#click" class="btn btn-sm btn-outline-danger" data-confirm="Are you sure?" data-token="{{ helper.generateCsrfToken('remove') }}">
                                            <svg fill="currentcolor" height="1em" width="1em" class="me-1 align-text-bottom" aria-hidden="true"><use xlink:href="#trash-icon"/></svg>
                                            Remove
                                        </a>
                                        {% if transport.isFailure %}
                                            <a href="{{ path('zenstruck_messenger_monitor_transport_retry', {name: transport.name, id: queued.id}) }}" data-controller="post-link" data-action="post-link#click" class="btn btn-sm btn-outline-secondary" data-token="{{ helper.generateCsrfToken('retry') }}">
                                                <svg fill="currentcolor" height="1em" width="1em" class="me-1 align-text-bottom" aria-hidden="true"><use xlink:href="#refresh-icon"/></svg>
                                                Retry
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
